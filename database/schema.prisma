// JARVIS - Prisma schema (Phase 1: Foundation)
// SQLite is used so the whole system runs with zero external infrastructure.
// Enums are not natively supported by SQLite, so "enum-like" fields are plain
// Strings with the allowed values documented and validated in application code
// (see core/memory, core/decision_engine, etc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & people
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  role         String   @default("OWNER") // OWNER | SYSTEM | AGENT | SERVICE (see core/auth/identity.ts) - authoritative for the identity a session resolves to
  active       Boolean  @default(true) // false = account disabled; sessions for an inactive user fail closed
  passwordHash String? // bcrypt hash; null until a login flow creates one (e.g. the owner seed script)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks         Task[]
  notifications Notification[]
  sessions      Session[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Auth: server-side, revocable sessions (Phase 3 / Identity & Events).
// Raw tokens are never stored - only a hash of the token, so a DB read alone
// can never be replayed as a valid session. See core/auth/session.ts.
// ---------------------------------------------------------------------------
model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model Contact {
  id                String    @id @default(uuid())
  firstName         String
  lastName          String?
  email             String?
  phone             String?
  title             String?
  companyId         String?
  notes             String?
  // Phase 7 (Email & CRM): normalized (lowercase, trimmed) email used for
  // dedup matching - see core/crm/dedup.ts. Kept separate from `email` (the
  // display value) so dedup never depends on formatting.
  normalizedEmail   String?
  // Phase 7: true when create/update matched an existing row ambiguously
  // (e.g. same name, different email) - never auto-merged, flagged for a
  // human to resolve. Never silently set back to false except by an explicit
  // dedup-resolution action.
  possibleDuplicate Boolean   @default(false)
  // Phase 7 anti-spam (item 17): hard suppression flag checked BEFORE outbound
  // risk classification even runs - see core/business/antiSpam.ts. Distinct
  // from the SuppressedContact table (which tracks WHY/WHEN), so a single
  // boolean read is enough on the hot path.
  unsubscribed      Boolean   @default(false)
  lastContactedAt   DateTime?
  // Phase 8 (WhatsApp, item 9): E.164-style canonical phone form used for
  // dedup/identity matching over WhatsApp - see core/crm/phone.ts. Kept
  // separate from `phone` (the display/raw value) for the exact same reason
  // normalizedEmail is kept separate from `email`: dedup must never depend
  // on formatting. Nullable/non-unique at the DB level on purpose - two
  // contacts can legitimately share no phone (most existing rows have none),
  // and findOrCreateContactByPhone() (core/crm/dedup.ts) is what enforces
  // "no fuzzy/ambiguous merge," not a DB constraint.
  normalizedPhone   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company        Company?        @relation(fields: [companyId], references: [id])
  leads          Lead[]
  communications Communication[]
  calls          Call[]
  emails         Email[]

  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@map("contacts")
}

model Company {
  id                String   @id @default(uuid())
  name              String
  industry          String?
  website           String?
  phone             String?
  address           String?
  notes             String?
  // Phase 7: normalized domain (lowercase host, no "www."/protocol) derived
  // from `website` - see core/crm/dedup.ts. Used for company-domain matching.
  domain            String?
  possibleDuplicate Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contacts Contact[]
  leads    Lead[]
  clients  Client[]
  quotes   Quote[]
  orders   Order[]

  @@index([domain])
  @@map("companies")
}

// ---------------------------------------------------------------------------
// CRM / pipeline
// ---------------------------------------------------------------------------

model Lead {
  id                String   @id @default(uuid())
  companyId         String?
  contactId         String?
  source            String? // e.g. "manual", "web-form", "cold-call" (Phase 2+)
  // Phase 7 (Email & CRM, item 6): extended pipeline, application-validated
  // (see core/crm/pipeline.ts) - SQLite has no enums, same convention as
  // every other status field in this schema:
  // NEW | RESEARCHING | QUALIFIED | CONTACTED | RESPONDED | SAMPLE_REQUESTED |
  // QUOTING | NEGOTIATION | WON | LOST | NURTURE
  status            String   @default("NEW")
  value             Float?
  notes             String?
  possibleDuplicate Boolean  @default(false)
  // Phase 7 (item 9): a lead created FROM research carries a real
  // ResearchRun reference - never a fabricated company/contact. Nullable:
  // most leads are still manually/CRM-created and have no research origin.
  researchRunId     String?
  // Phase 7 (item 10): last qualification result, application-validated
  // JSON ({ qualified: true|false|"UNKNOWN", reasons: string[], scoredAt }) -
  // see core/crm/qualification.ts. Never a bare opaque number.
  qualification     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([researchRunId])
  @@map("leads")
}

model Client {
  id        String   @id @default(uuid())
  companyId String?
  status    String   @default("ACTIVE") // ACTIVE | INACTIVE | ARCHIVED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
  orders  Order[]
  quotes  Quote[]

  @@map("clients")
}

// ---------------------------------------------------------------------------
// Communications (Phase 2+ channels are stubbed at the tool layer, not here)
// ---------------------------------------------------------------------------

model Communication {
  id              String   @id @default(uuid())
  contactId       String?
  channel         String // email | call | sms | whatsapp | chat
  direction       String // inbound | outbound
  summary         String?
  // Phase 7 (item 19): activity type for CRM activity-feed grouping,
  // application-validated - NOTE | EMAIL_SENT | EMAIL_RECEIVED | CALL_LOGGED |
  // STATUS_CHANGE | QUOTE_PREPARED | SAMPLE_REQUESTED | FOLLOW_UP |
  // TASK_LINKED. Left nullable so every pre-Phase-7 row (channel/direction
  // only) still reads back fine.
  activityType    String?
  // Phase 7: id of the related Lead/Quote/Task this activity concerns, so an
  // activity feed can be filtered per pipeline entity without a new table.
  relatedEntityId String?
  metadata        String? // JSON-encoded extra detail (never raw secrets)
  createdAt       DateTime @default(now())

  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([relatedEntityId])
  @@map("communications")
}

// Phase 9 (Voice + Phone/Telephony): GENERALIZED (additive fields only) to
// carry a real call session, rather than forking a parallel "CallSession"
// table - the exact same discipline Phase 8 used for Email/WhatsApp (see
// docs/PHASE8_WHATSAPP.md's "which tables were generalized" section, and
// docs/PHASE9_VOICE.md for this phase's own rationale). Every pre-Phase-9 row
// still reads back unchanged: `status` keeps its historical
// "NOT_IMPLEMENTED" default, and every new column is nullable/defaulted.
model Call {
  id           String    @id @default(uuid())
  contactId    String?
  companyId    String?
  // The open Lead (this CRM's "opportunity" concept - there is no separate
  // Opportunity model) this call concerns, if any.
  leadId       String?
  direction    String // inbound | outbound
  status       String    @default("NOT_IMPLEMENTED") // NOT_IMPLEMENTED until a real provider is configured; then RINGING | IN_PROGRESS | COMPLETED | FAILED | NO_ANSWER | BUSY | CANCELED | BLOCKED
  durationSecs Int?
  transcript   String?
  startedAt    DateTime?
  answeredAt   DateTime?
  endedAt      DateTime?
  createdAt    DateTime  @default(now())

  // --- Phase 9 additions (all additive/nullable) -------------------------
  provider               String? // e.g. "twilio" | "mock"
  // The provider's own call id - the natural idempotent-upsert key for
  // inbound webhook events (mirrors Email.providerMessageId's role for
  // WhatsApp/email), and the DB-unique dedup mechanism for inbound call
  // webhook events (item 5).
  providerCallId         String? @unique
  callerNumber           String? // raw, as received from the provider
  // Canonical E.164-style form via the ONE shared core/crm/dedup.ts
  // normalizePhone() - never a second normalizer (item 7).
  normalizedCallerNumber String?
  // Phase 9 (item 12): the same computeChannelIdempotencyKey()/
  // reserveIdempotencyKey() mechanism email/WhatsApp use, channel "VOICE".
  idempotencyKey         String? @unique
  riskCategory           String? // LOW | HIGH, see core/business/outboundPolicy.ts's classifyOutboundVoice()
  // NOT_RECORDED by default (item 21: recording is OFF unless
  // VOICE_RECORDING_ENABLED=true) | METADATA_ONLY | RECORDED
  recordingStatus        String  @default("NOT_RECORDED")
  transcriptionStatus    String? // NOT_TRANSCRIBED | PENDING | COMPLETE | FAILED
  transcriptLanguage     String?
  transcriptConfidence   Float?
  // Deterministic voice intent (core/business/voiceIntent.ts), e.g.
  // CALLBACK_REQUEST | HUMAN_AGENT_REQUEST | WRONG_NUMBER | DO_NOT_CALL |
  // IDENTITY_UNCLEAR | PRICING_REQUEST | ... | UNKNOWN.
  intent                 String?
  // HUMAN_HANDOFF | CALLBACK_SCHEDULED | COMPLETED | NO_ANSWER | ... - see
  // core/voice/ingest.ts.
  outcome                String?
  // Estimated cost (transcription minutes + provider per-minute rate), if
  // computable - honestly null when no real cost data exists.
  costEstimate           Float?

  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([normalizedCallerNumber])
  @@index([contactId])
  @@map("calls")
}

// Phase 8 (WhatsApp & Unified Customer Communications, item 2): GENERALIZED
// to be channel-aware rather than forked into a parallel WhatsAppMessage
// table - despite the model/table name, this is now the message-log row for
// BOTH channels (see docs/PHASE8_WHATSAPP.md's "which tables were
// generalized" section for the full rationale). Every field below already
// fit a WhatsApp message with no reinterpretation: `subject` is simply left
// null for WhatsApp (it was already nullable), `toAddress`/`fromAddress`
// hold phone numbers instead of email addresses, `providerMessageId` is the
// WhatsApp message id (still the natural idempotent-upsert key - same
// discipline as core/email/ingest.ts, see core/whatsapp/ingest.ts), and
// `idempotencyKey`/`riskCategory` are computed by the SAME
// core/business/idempotency.ts and core/business/outboundPolicy.ts every
// email send already uses, just with `channel` folded into the key basis.
model Email {
  id                     String   @id @default(uuid())
  contactId              String?
  direction              String // inbound | outbound
  // Phase 8 (item 2): "EMAIL" | "WHATSAPP" (other channels remain literal
  // NOT_IMPLEMENTED strings at the tool layer, never built here). Defaults
  // to "EMAIL" so every pre-Phase-8 row reads back unchanged.
  channel                String   @default("EMAIL")
  subject                String?
  body                   String?
  // Phase 7 (Email & CRM): real statuses once tools/email/ is configured -
  // RECEIVED | DRAFT | REQUIRES_APPROVAL | SENDING | SENT | FAILED |
  // BLOCKED | CONFIGURATION_REQUIRED. Default unchanged for backward
  // compatibility with any pre-Phase-7 row.
  status                 String   @default("NOT_IMPLEMENTED")
  // Phase 7 (item 5): the email provider's own message id - the natural key
  // for idempotent upsert-by-provider-id (a retry must never duplicate the
  // row this message already has). Nullable because a not-yet-sent DRAFT has
  // no provider id yet.
  providerMessageId      String?  @unique
  threadId               String?
  toAddress              String?
  fromAddress            String?
  // Phase 7 (item 13): deterministic pre-classification + optional
  // AI-assisted classification result - see core/business/emailClassification.ts.
  // Application-validated category string, never a free-form LLM action.
  classification         String?
  classificationReasons  String? // JSON array of strings - always paired with classification
  // Phase 7 (item 16): the outbound risk classification this email was sent
  // (or blocked) under - LOW | HIGH - see core/business/outboundPolicy.ts.
  riskCategory           String?
  // Phase 7 (item 18): idempotency key checked before any real provider send
  // - see core/business/idempotency.ts and the OutboundSendLog table.
  idempotencyKey         String?  @unique
  relatedLeadId          String?
  // Phase 8 (item 7): the provider's own conversation/thread id for a
  // channel where that's a first-class concept distinct from `threadId`
  // (email's In-Reply-To threading) - e.g. the WhatsApp Business Platform's
  // conversation id, used for deterministic conversation identity together
  // with the business account + contact (see core/whatsapp/conversation.ts).
  providerConversationId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([threadId])
  @@index([relatedLeadId])
  @@index([channel])
  @@index([providerConversationId])
  @@map("emails")
}

// ---------------------------------------------------------------------------
// Commercial documents
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  description String?
  unitPrice   Float?
  unit        String? // e.g. "case", "kg", "roll"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model Quote {
  id                String    @id @default(uuid())
  clientId          String?
  companyId         String?
  // Phase 7 (item 21): extended - DRAFT | REQUIRES_APPROVAL | SENT | ACCEPTED
  // | REJECTED. A quote may ONLY move DRAFT -> REQUIRES_APPROVAL -> SENT via
  // an OWNER-approved ApprovalRequest (core/approvals) - never autonomously.
  // See core/business/quote.test.ts / agents/no-autonomous-quote-send.test.ts.
  status            String    @default("DRAFT")
  total             Float?
  // Phase 7: true only if `total` was computed from configured costing rules
  // (core/crm/businessConfig.ts) - never fabricated pricing. When false and
  // total is null, the quote is a spec collection awaiting owner input.
  totalIsComputed   Boolean   @default(false)
  approvalRequestId String?
  sentAt            DateTime?
  lineItems         String? // JSON-encoded array; kept simple for Phase 1
  leadId            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client  Client?  @relation(fields: [clientId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@map("quotes")
}

model Order {
  id        String   @id @default(uuid())
  clientId  String?
  companyId String?
  status    String   @default("PENDING") // PENDING | CONFIRMED | FULFILLED | CANCELLED
  total     Float?
  lineItems String? // JSON-encoded array; kept simple for Phase 1
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  Client?  @relation(fields: [clientId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@map("orders")
}

// ---------------------------------------------------------------------------
// Work: tasks & agents
// ---------------------------------------------------------------------------

model Task {
  id                     String    @id @default(uuid())
  title                  String
  description            String?
  // Phase 2 (Autonomy Core) status set, reconciling the Phase 1 set with the
  // spec addendum's QUEUED/WAITING/CANCELLED/RETRYING states:
  // PENDING | QUEUED | IN_PROGRESS | WAITING | BLOCKED | RETRYING | DONE | FAILED | CANCELLED
  status                 String    @default("PENDING")
  // Phase 5 (Autonomous Worker): canonical 4-level priority, reconciling the
  // Phase 1-4 LOW|NORMAL|HIGH|URGENT set with the spec's CRITICAL|HIGH|NORMAL|LOW
  // set. URGENT is retired in favor of CRITICAL (see migration
  // phase5_autonomous_worker, which rewrites any existing "URGENT" rows).
  priority               String    @default("NORMAL") // CRITICAL | HIGH | NORMAL | LOW
  retryCount             Int       @default(0)
  ownerId                String?
  parentId               String?
  dueAt                  DateTime?
  // Phase 4 (Brain & Memory): when this Task was created from a validated
  // Plan step (core/brain/plan.ts), these record which step it came from so
  // the Brain can map Task rows back to plan steps for verification/re-plan.
  stepId                 String? // Plan.steps[].stepId, if this task originated from a Brain plan
  agentName              String? // Plan.steps[].agent, if the step delegates to an agent
  toolName               String? // Plan.steps[].tool, if the step calls a tool directly
  // Phase 5 (Autonomous Worker): explicit, persisted reason a task is
  // currently WAITING (transient/informational blocker) or BLOCKED
  // (policy/system blocker) - see core/worker/eligibility.ts.
  waitingReason          String?
  blockedReason          String?
  failureReason          String? // Phase 5: last real error message for a FAILED task (core/reports/dailyReport.ts reads this - never fabricated)
  // Phase 5: DB-backed claiming so two concurrent worker slots (or, in
  // principle, two processes sharing one SQLite file) cannot both execute the
  // same task - see core/worker/claim.ts. A claim expires so a crashed
  // worker's abandoned claim becomes reclaimable (crash recovery).
  claimedBy              String?
  claimedAt              DateTime?
  claimExpiresAt         DateTime?
  // Phase 5: last time the worker evaluated this task's eligibility while it
  // was WAITING/BLOCKED - used for backoff (never re-check every tick).
  lastEligibilityCheckAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  owner    User?  @relation(fields: [ownerId], references: [id])
  parent   Task?  @relation("TaskSubtasks", fields: [parentId], references: [id])
  subtasks Task[] @relation("TaskSubtasks")

  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Autonomous Worker (Phase 5) - heartbeat so the worker loop's liveness is
// observable and recoverable even though it runs in-process (see
// core/worker/heartbeat.ts, core/worker/watchdog.ts).
// ---------------------------------------------------------------------------
model WorkerHeartbeat {
  id             String   @id @default(uuid())
  workerId       String   @unique
  startedAt      DateTime @default(now())
  lastHeartbeat  DateTime @default(now())
  currentTaskId  String?
  status         String   @default("IDLE") // RUNNING | IDLE | DEGRADED | STOPPED | CRASHED
  processedTasks Int      @default(0)
  failedTasks    Int      @default(0)
  restartCount   Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("worker_heartbeats")
}

// One row per generated Daily Executive Report (Phase 5 /
// core/reports/dailyReport.ts) - a dedicated small table rather than
// overloading Memory, since a report is a distinct, queryable business
// artifact with its own date identity.
model DailyReport {
  id         String   @id @default(uuid())
  reportDate String   @unique // YYYY-MM-DD (UTC)
  content    String // JSON-encoded DailyReportContent
  createdAt  DateTime @default(now())

  @@map("daily_reports")
}

model Agent {
  id        String   @id @default(uuid())
  name      String   @unique
  objective String
  status    String   @default("IDLE") // IDLE | RUNNING | NOT_IMPLEMENTED | ERROR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs AgentRun[]

  @@map("agents")
}

model AgentRun {
  id        String    @id @default(uuid())
  agentId   String
  status    String    @default("RUNNING") // RUNNING | SUCCESS | FAILED | NOT_IMPLEMENTED
  input     String?
  output    String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  agent Agent @relation(fields: [agentId], references: [id])

  @@map("agent_runs")
}

// ---------------------------------------------------------------------------
// Memory (see core/memory) - append-only, namespaced
// ---------------------------------------------------------------------------

// Memory (Phase 4 upgrade): `content` is the primary human-readable field;
// `value` remains the JSON-encoded structured payload (kept for backward
// compatibility with Phase 1-3 callers that only ever set `value`). Both are
// optional at the DB level but at least one is always populated by
// core/memory. See docs/PHASE4_BRAIN_MEMORY.md for the full design note.
model Memory {
  id            String    @id @default(uuid())
  namespace     String // PERSONAL | BUSINESS | CLIENT | PROJECT | PREFERENCE | KNOWLEDGE | TASK | CONVERSATION | EVENT | DECISION
  key           String // logical key a value belongs to, used for conflict/history resolution
  value         String // JSON-encoded structured payload
  content       String? // human-readable summary (Phase 4); falls back to `value` when absent
  source        String? // e.g. "user", "agent:research", "brain", "system"
  confidence    Float     @default(1) // 0 (low) - 1 (certain)
  relatedEntity String? // e.g. a lead/company id this memory concerns
  metadata      String? // JSON-encoded free-form metadata
  expiresAt     DateTime? // "forget" semantics: excluded from search()/retrieve() once past, never deleted
  importance    Int       @default(5) // 1 (low) - 10 (critical)
  status        String    @default("ACTIVE") // ACTIVE | ARCHIVED
  supersedes    String? // id of the memory entry this one replaces, if any
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  @@index([namespace, key])
  @@map("memory")
}

// ---------------------------------------------------------------------------
// AI usage & cost tracking (Phase 4 / Brain & Memory). One row per LLM call,
// real token counts from the provider's own response - never estimated.
// estimatedCostUsd is computed from a documented, approximate per-model rate
// table (core/ai/pricing.ts) - NOT exact billing.
// ---------------------------------------------------------------------------
model AiUsage {
  id               String   @id @default(uuid())
  provider         String // e.g. "anthropic"
  model            String
  inputTokens      Int
  outputTokens     Int
  estimatedCostUsd Float
  taskId           String?
  agentName        String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@map("ai_usage")
}

// ---------------------------------------------------------------------------
// System: events, automations, notifications, documents, knowledge, skills
// ---------------------------------------------------------------------------

model Event {
  id        String   @id @default(uuid())
  type      String
  payload   String? // JSON-encoded
  source    String?
  createdAt DateTime @default(now())

  @@map("events")
}

model Automation {
  id          String    @id @default(uuid())
  name        String    @unique
  triggerType String // one_time | daily | weekly | monthly | interval | event | condition
  schedule    String? // cron expression or ISO date, depending on triggerType
  timezone    String    @default("UTC") // IANA timezone name passed to node-cron
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  runs AutomationRun[]

  @@map("automations")
}

// Per-run execution history for a scheduled job (Phase 3): supports missed-
// schedule detection, duplicate-execution prevention, and retry/failure
// auditing without overloading the single `lastRunAt` column on Automation.
model AutomationRun {
  id           String    @id @default(uuid())
  automationId String
  status       String    @default("RUNNING") // RUNNING | SUCCESS | FAILED
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  error        String?
  attempt      Int       @default(1)

  automation Automation @relation(fields: [automationId], references: [id])

  @@index([automationId])
  @@map("automation_runs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  body      String?
  type      String   @default("INFO") // INFO | WARNING | ACTION_REQUIRED | ERROR | CRITICAL
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Condition Engine (Phase 3 / Identity & Events): declarative rules linking
// an event type/category to a condition (JSON, never executable code) and an
// action to take when it matches. Kept separate from `Automation` (which is
// specifically cron/time-driven jobs) because a ConditionRule reacts to
// *events*, not the clock - see core/conditions and docs/PHASE3_IDENTITY_EVENTS.md.
// ---------------------------------------------------------------------------
model ConditionRule {
  id            String   @id @default(uuid())
  name          String   @unique
  eventType     String // exact event type this rule listens for, e.g. "crm.lead.created"
  conditionJson String // JSON condition tree (see core/conditions) - never eval'd, only walked
  actionType    String // "create_task" (the only implemented action kind in this phase)
  actionParams  String // JSON-encoded params for actionType, e.g. { "title": "...", "template": "research" }
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("condition_rules")
}

model Document {
  id        String   @id @default(uuid())
  title     String
  path      String? // path within the sandboxed file store
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@map("documents")
}

model Knowledge {
  id        String   @id @default(uuid())
  topic     String
  content   String
  source    String?
  createdAt DateTime @default(now())

  @@map("knowledge")
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("skills")
}

// ---------------------------------------------------------------------------
// Phase 6 (Web Research & Autonomous Intelligence): source provenance.
//
// One ResearchRun per research task/query. Each source it looked at
// (a search-result row or a fetched page) is a ResearchSource. Each concrete
// piece of extracted information from a source is a ResearchEvidence row,
// classified FACT | SOURCE_CLAIM | ANALYSIS | UNCERTAINTY (a source claiming
// something is SOURCE_CLAIM, never automatically FACT). Memory rows written
// from research set `relatedEntity` to the ResearchEvidence id so
// Memory -> ResearchEvidence -> ResearchSource -> ResearchRun is a real,
// queryable provenance chain ("where did you get this information").
// ---------------------------------------------------------------------------
model ResearchRun {
  id          String    @id @default(uuid())
  taskId      String?
  query       String
  status      String    @default("RUNNING") // RUNNING | SUCCESS | PARTIAL | FAILED | NOT_IMPLEMENTED
  createdBy   String // Identity label, e.g. "agent:research", "service:worker"
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  summary     String? // final synthesized summary, if any

  sources ResearchSource[]

  @@index([taskId])
  @@map("research_runs")
}

model ResearchSource {
  id                String    @id @default(uuid())
  researchRunId     String
  url               String
  canonicalUrl      String
  domain            String
  title             String?
  retrievedAt       DateTime  @default(now())
  publishedAt       DateTime?
  contentHash       String? // sha256 of extracted text, for dedup/change detection
  sourceType        String // search_result | fetched_page
  discoveredByQuery String?

  researchRun ResearchRun        @relation(fields: [researchRunId], references: [id])
  evidence    ResearchEvidence[]

  @@index([canonicalUrl])
  @@index([contentHash])
  @@map("research_sources")
}

model ResearchEvidence {
  id               String   @id @default(uuid())
  researchSourceId String
  extractedText    String
  classification   String // FACT | SOURCE_CLAIM | ANALYSIS | UNCERTAINTY
  relatedTaskId    String?
  createdAt        DateTime @default(now())

  researchSource ResearchSource @relation(fields: [researchSourceId], references: [id])

  @@index([relatedTaskId])
  @@map("research_evidence")
}

// Business Intelligence tracked topics (Phase 6, item 8): DATA rows, never
// hardcoded business logic. Also drives the WebEventSource poller (item 7).
model ResearchTopic {
  id                  String    @id @default(uuid())
  name                String    @unique
  query               String
  enabled             Boolean   @default(true)
  pollIntervalMinutes Int       @default(1440) // default: once/day, never more than once/hour (enforced in code)
  lastPolledAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("research_topics")
}

// Skill Discovery / Registry (Phase 6, items 11-14) - a FOUNDATION-only
// lifecycle tracker. A skill can reach ACTIVATABLE for real, but never
// ACTIVE automatically - see core/skills/registry.ts and
// docs/PHASE6_WEB_RESEARCH.md for exactly where the line is drawn.
model SkillCandidate {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  version             String   @default("0.1.0")
  source              String // where the candidate came from (URL, "manual", etc.)
  capabilities        String? // JSON array
  requiredPermissions String? // JSON array
  dependencies        String? // JSON array
  riskLevel           String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  testStatus          String   @default("NOT_RUN") // NOT_RUN | NOT_IMPLEMENTED | PASSED | FAILED
  securityStatus      String   @default("PENDING") // PENDING | PASSED | REJECTED
  activationStatus    String   @default("DISCOVERED")
  // DISCOVERED | CANDIDATE | ANALYZING | TESTING | VERIFIED | ACTIVATABLE | ACTIVE | REJECTED | DISABLED | DEPRECATED
  rejectionReason     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("skill_candidates")
}

// ---------------------------------------------------------------------------
// Phase 7 (Email & CRM): outbound safety infrastructure.
//
// SuppressedContact is the durable, auditable record of WHY/WHEN a contact
// was suppressed (unsubscribe, hard bounce, manual owner action) -
// Contact.unsubscribed is the fast boolean read on the hot send path, this
// table is the record of truth behind it. Checked BEFORE outbound risk
// classification even runs - see core/business/antiSpam.ts.
// ---------------------------------------------------------------------------
// Phase 8 (item 10): generalized to cover WhatsApp identifiers too, rather
// than a parallel WhatsApp-only suppression table. `normalizedEmail` is
// relaxed from required to optional (existing rows are unaffected - every
// one already has a value) and `normalizedPhone` is added alongside it; a
// row always has at least one of the two set (enforced in application code,
// core/business/antiSpam.ts - SQLite has no CHECK-constraint support worth
// relying on here, same "app-validated" convention as every status field in
// this schema). Each identifier keeps its own unique constraint so an email
// suppression and a phone suppression for the "same" real person remain two
// independently-created, independently-auditable rows (never silently
// merged) unless a caller explicitly links them via `contactId`.
model SuppressedContact {
  id              String   @id @default(uuid())
  normalizedEmail String?  @unique
  normalizedPhone String?  @unique
  reason          String // UNSUBSCRIBE | BOUNCE | MANUAL | COMPLAINT
  contactId       String?
  createdAt       DateTime @default(now())

  @@map("suppressed_contacts")
}

// Phase 7.1 (hardening, items 2-5): a real, persisted follow-up - one row per
// scheduled step in a lead/contact's follow-up sequence. `leadId +
// sequenceStep` is the natural idempotency key for "this specific follow-up
// in this specific sequence" (a DB unique constraint, distinct from the
// email-send-level idempotencyKey in OutboundSendLog/Email, which is keyed
// off taskId + contact + content hash - belt-and-suspenders, not a
// replacement). `subject`/`body` are captured at SCHEDULING time (via the
// same deterministic core/business/emailDraft.ts template generator every
// other draft uses - never invented at send time), so the send itself only
// ever re-validates cancellation conditions and re-runs the full
// suppression/anti-spam/idempotency/risk/approval pipeline inside
// tools/email/emailTool.ts's existing `send` action - no second sender.
model FollowUp {
  id           String   @id @default(uuid())
  leadId       String?
  contactId    String?
  sequenceStep Int      @default(1)
  // Phase 8 (item 20): "EMAIL" | "WHATSAPP" - which tool the dispatcher tags
  // the Task with (toolName: "email" | "whatsapp"). Reuses the SAME
  // scheduleDueFollowUps() dispatch pass / hourly job for both channels -
  // deliberately NOT a second scheduler (see core/business/followUp.ts).
  channel      String   @default("EMAIL")
  subject      String
  body         String
  scheduledFor DateTime
  // SCHEDULED | CANCELLED | EXECUTED | SKIPPED (application-validated, same
  // "SQLite has no enums" convention as every other status field here).
  status       String   @default("SCHEDULED")
  cancelReason String?
  // The Task row that will (or did) execute this follow-up, tagged
  // toolName:"email" so the worker calls the SAME guarded email tool every
  // other send goes through. Unique: at most one Task per FollowUp, set
  // exactly once by the dispatch pass (core/business/followUp.ts).
  taskId       String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([leadId, sequenceStep])
  @@index([status, scheduledFor])
  @@map("follow_ups")
}

// One row per outbound send ATTEMPT (not per successful send) - the
// idempotency ledger (item 18). idempotencyKey is derived from
// hash(taskId + contentHash) by core/business/idempotency.ts; a unique
// constraint here is what makes a retried task provably unable to
// double-send, not just "unlikely to."
model OutboundSendLog {
  id                String   @id @default(uuid())
  idempotencyKey    String   @unique
  taskId            String?
  contactId         String?
  emailId           String?
  // Phase 8 (item 23): recorded for observability/filtering only - `channel`
  // is ALSO folded into idempotencyKey's own hash basis (see
  // core/business/idempotency.ts), so cross-channel idempotency does not
  // depend on this column; it exists so a dashboard/report can group by
  // channel without re-deriving it from the key.
  channel           String   @default("EMAIL")
  // SENDING | SENT | FAILED | BLOCKED - SENDING is a Phase 7.1 addition: the
  // atomic-reservation row inserted by core/business/idempotency.ts's
  // reserveIdempotencyKey() the instant BEFORE the real provider call, so
  // the unique constraint on idempotencyKey (not an in-memory lock) is what
  // makes two truly-concurrent identical sends resolve to exactly one real
  // provider call.
  status            String // SENDING | SENT | FAILED | BLOCKED
  providerMessageId String?
  createdAt         DateTime @default(now())

  @@map("outbound_send_log")
}

// Phase 7 (item 26): the Owner Approval Queue. Approving/rejecting NEVER
// mutates proposedContent - see core/approvals/index.ts. Every decision is
// audited via the normal security/audit.ts path (the approve/reject HTTP
// routes call writeAuditLog like every other authenticated write).
model ApprovalRequest {
  id                 String    @id @default(uuid())
  action             String // e.g. "email.send", "quote.send"
  reason             String
  target             String // e.g. a Contact/Company/Lead id, human-readable in `target`
  proposedContent    String // JSON-encoded, e.g. { subject, body, to } - immutable once created
  supportingContext  String? // JSON-encoded (CRM context, research refs, etc.)
  riskClassification String // HIGH | CRITICAL (only HIGH-risk-or-above actions ever reach this queue)
  // Phase 8 (item 29): "EMAIL" | "WHATSAPP" - which channel this approval
  // concerns. Additive/optional-by-default column for filtering; the actual
  // channel/recipient-phone/conversation-id detail already lives in
  // `supportingContext` JSON (no schema change needed there - see
  // tools/whatsapp/whatsappTool.ts).
  channel            String    @default("EMAIL")
  taskId             String?
  idempotencyKey     String?   @unique
  status             String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  createdBy          String // Identity label
  decidedBy          String?
  decidedAt          DateTime?
  decisionNote       String?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([taskId])
  @@map("approval_requests")
}

// Phase 7 (item 11): Prime Pak's product categories/positioning as DATA,
// never hardcoded business claims in TypeScript. Draft generation
// (core/business/emailDraft.ts) and quote preparation (core/business/quote.ts)
// may ONLY cite facts present in this table (or explicit config rows) -
// anything else becomes a placeholder in a draft/quote, never an invention.
model ProductCategory {
  id                  String   @id @default(uuid())
  name                String   @unique
  description         String?
  positioning         String?
  certifications      String? // JSON array of strings
  minOrderQuantity    String?
  productionTimeNotes String?
  costingRulesJson    String? // JSON: { unit, baseUnitCost, currency } - only used if present
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("product_categories")
}

// ---------------------------------------------------------------------------
// Observability & security
// ---------------------------------------------------------------------------

model SystemLog {
  id        String   @id @default(uuid())
  category  String // INFO | WARNING | ERROR | CRITICAL | ACTION | AGENT | TOOL | SECURITY | BUSINESS | VOICE
  message   String
  meta      String? // JSON-encoded, redacted
  createdAt DateTime @default(now())

  @@map("system_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String // user id, "system", or agent name
  action    String
  target    String?
  meta      String? // JSON-encoded, redacted
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// Phase 11 (Business Intelligence, section 8): an immutable, one-per-period
// snapshot of deterministically-computed KPIs. Additive-only table - no
// existing model changes. "Immutable once generated" means CODE never calls
// .update()/.delete() on this model (enforced by convention + tests, same
// discipline as ResearchEvidence/AuditLog); a mis-generated snapshot is
// superseded by creating a NEW row for the same period (never edited in
// place), matching core/memory's append-only/supersede discipline.
// periodKey + snapshotType is the deterministic idempotency key (DB-unique)
// so a worker retry regenerating the same period's snapshot cannot create a
// duplicate row - see core/business/idempotency.ts's discipline, reused here
// as a design pattern (this table uses its own unique constraint rather than
// OutboundSendLog, since a snapshot is not an outbound send).
model BusinessSnapshot {
  id            String   @id @default(uuid())
  // Deterministic key: `${snapshotType}:${periodStart-ISO}:${periodEnd-ISO}`.
  // Unique together with snapshotType below (belt-and-suspenders: the
  // periodKey alone already encodes the type, but keeping both indexed
  // columns makes querying by type alone fast and the constraint legible).
  periodKey     String
  // "DAILY" | "WEEKLY" | "MONTHLY" | "CUSTOM" - which reporting cadence this
  // snapshot covers (section 9's time windows, resolved to concrete bounds
  // at generation time - see core/business/intelligence/timeWindows.ts).
  snapshotType  String
  periodStart   DateTime
  periodEnd     DateTime
  generatedAt   DateTime @default(now())
  // JSON-encoded Record<string, IntelligenceStatement> (see
  // core/business/intelligence/types.ts) - every metric tagged with its
  // FACT/OBSERVATION/CALCULATION/FORECAST/INFERENCE/RECOMMENDATION/UNKNOWN
  // classification, never a bare number.
  metricsJson   String
  // JSON-encoded provenance: source record ids, date range, calculation
  // method per metric (section 5-7) - never just a number with no lineage.
  provenanceJson String
  createdAt     DateTime @default(now())

  @@unique([periodKey, snapshotType])
  @@index([snapshotType, periodStart])
  @@map("business_snapshots")
}

model Setting {
  key       String   @id
  value     String // JSON-encoded
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Phase 10 (Browser & Computer Control) - additive only.
// ---------------------------------------------------------------------------

// A single isolated browser session: one Playwright BrowserContext per row
// (see core/browser/session.ts and tools/browser/playwrightProvider.ts) -
// never shared across sessions/tasks. Purely metadata here; the live
// Playwright object itself lives only in the process's in-memory session
// registry and is disposed on close/expiry, never persisted.
model BrowserSession {
  id             String    @id @default(uuid())
  provider       String // "playwright" | "mock"
  // Phase 10.1 (browser session lifecycle hardening): extended status set -
  // CREATED | ACTIVE | IDLE | CLEANING | EXPIRED | CLOSED | CRASHED |
  // ORPHANED | CLEANUP_FAILED. SQLite has no enums, so this is validated in
  // code (core/browser/session.ts's SESSION_STATUSES/isValidSessionStatus),
  // same convention as Task.status. The
  // ACTIVE/IDLE/ORPHANED/EXPIRED/CRASHED -> CLEANING transition is an atomic
  // conditional updateMany (mirrors core/worker/claim.ts's claimTask()), so
  // only one concurrent cleanup caller ever wins and calls the provider.
  status         String    @default("ACTIVE")
  profileId      String? // reserved for a future named-profile concept; unused this phase
  currentUrl     String?
  currentDomain  String?
  isolationLevel String    @default("CONTEXT") // "CONTEXT" - a fresh Playwright BrowserContext per session
  taskId         String?
  createdBy      String // Identity label ("owner" | "system" | agent name) - doubles as owner for isolation checks
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  closedAt       DateTime?
  closeReason    String?
  // Phase 10.1: bounded-retry cleanup-failure bookkeeping (section 29/30) -
  // persisted so a failure is never silently discarded and survives a
  // process restart (never held only in memory).
  cleanupAttempts      Int       @default(0)
  lastCleanupError     String?
  lastCleanupAttemptAt DateTime?
  nextCleanupRetryAt   DateTime?

  @@index([status])
  @@index([taskId])
  @@map("browser_sessions")
}

// One browser-driven action/step, integrated with the existing Task system
// (Phase 5) via taskId - dispatched by the SAME worker mechanism, no second
// scheduler (see tools/browser/browserTool.ts's `toolName: "browser"`
// tagging, reusing Phase 7.1's `{taskId: task.id}` pass-through).
model BrowserTask {
  id            String    @id @default(uuid())
  taskId        String? // FK-by-convention to Task.id (Task has no back-relation array; same loose-FK style as Call.leadId etc.)
  sessionId     String? // FK-by-convention to BrowserSession.id
  domain        String?
  action        String // e.g. "navigate" | "click" | "type" | "submit" | "download" | "upload"
  targetText    String?
  riskCategory  String? // READ_ONLY | LOW | MEDIUM | HIGH | BLOCKED - see core/business/browserPolicy.ts
  status        String    @default("PENDING") // PENDING | APPROVAL_REQUIRED | BLOCKED | IN_PROGRESS | DONE | FAILED
  approvalId    String?
  result        String? // JSON-encoded, bounded observation (never raw HTML/full page dump)
  failureReason String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([taskId])
  @@index([sessionId])
  @@index([status])
  @@map("browser_tasks")
}
