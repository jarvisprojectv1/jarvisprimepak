# JARVIS - Phase 1 (Foundation) environment variables
# Copy this file to `.env` at the repo root and fill in real values.
# Nothing here is a real secret. Everything is optional unless noted -
# missing optional vars cause a typed CONFIGURATION_REQUIRED result at the
# point of use, not a boot-time crash.

# --- Core server -------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Database (SQLite via Prisma; no external DB server needed) --------
DATABASE_URL="file:./dev.db"

# --- AI provider (required for /chat and the orchestrator to do anything
# beyond echoing CONFIGURATION_REQUIRED) --------------------------------
ANTHROPIC_API_KEY=

# --- Sandbox for the `files` tool (defaults to <repo>/data/sandbox) ----
SANDBOX_DIR=

# --- Auth / Owner identity (Phase 3) ------------------------------------
# Used ONLY by `npm run seed:owner` (scripts/seed-owner.ts), never read by
# any HTTP endpoint - this is how the single OWNER account is created.
OWNER_EMAIL=
# If left blank, the seed script generates a random password and prints it
# once; it is never stored anywhere in plaintext.
OWNER_PASSWORD=
# Session token lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# --- Phase 2+ integrations (NOT IMPLEMENTED in Phase 1; listed here so
# every env var referenced anywhere in the code is documented up front) -
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# --- Phase 6: Web Research (optional - tools/web returns CONFIGURATION_REQUIRED
# without a key, exactly like ANTHROPIC_API_KEY above) --------------------
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_MS=
# --- Phase 7: Email & CRM (optional - tools/email returns CONFIGURATION_REQUIRED
# without these, exactly like BRAVE_SEARCH_API_KEY above). Real Gmail API v1
# implementation (tools/email/gmailProvider.ts), UNTESTED against the live
# API in this sandbox - see docs/PHASE7_EMAIL_CRM.md. GMAIL_ACCESS_TOKEN is a
# valid OAuth2 access token for the mailbox; token refresh is out of scope
# for this phase (a short-lived token must be supplied directly). NEVER
# commit a real value here - this file only documents the variable names.
GMAIL_ACCESS_TOKEN=
GMAIL_USER_EMAIL=
WEB_SEARCH_MAX_RETRIES=
WEB_SEARCH_DEFAULT_COUNT=
WEB_FETCH_TIMEOUT_MS=
WEB_FETCH_MAX_REDIRECTS=
WEB_FETCH_MAX_BYTES=
WEB_FETCH_MAX_TEXT_CHARS=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_BUSINESS_TOKEN=
BROWSERBASE_API_KEY=
