{
  "name": "jarvis-primepak",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS - Autonomous AI Operating System for Prime Pak Packages (Phase 1: Foundation)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema=database/schema.prisma",
    "prisma:generate": "prisma generate --schema=database/schema.prisma",
    "prisma:migrate": "cross-env DATABASE_URL=file:./dev.db prisma migrate dev --schema=database/schema.prisma --name init",
    "prisma:studio": "cross-env DATABASE_URL=file:./dev.db prisma studio --schema=database/schema.prisma",
    "seed:owner": "tsx scripts/seed-owner.ts",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "pretest": "cross-env DATABASE_URL=file:./dev.db prisma migrate deploy --schema=database/schema.prisma",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "prisma": "^5.19.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@prisma/client": "^5.19.1",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2"
  }
}
